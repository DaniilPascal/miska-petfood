# Скопируйте в .env и при необходимости измените значения.
# Файл .env в git не коммитится.

# Путь к SQLite (в Docker удобно держать на volume)
MISKA_DB_PATH=/app/backend/miska.db

# CORS: * или список через запятую
MISKA_CORS_ORIGINS=*

# Тестовая учётная запись (создаётся при старте, если её ещё нет)
MISKA_DEMO_EMAIL=demo@miska.shop
MISKA_DEMO_PASSWORD=demo1234
MISKA_DEMO_NAME=Демо Пользователь

# Версия приложения
MISKA_APP_VERSION=4.0.0

# Порт (Render/Railway подставляют свой PORT)
PORT=8000
